# Paste these from Supabase → Project Settings → API
# (do not use the service_role key)

# 1) Project URL  — e.g. https://abcdefghijk.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# 2) anon public key  — long string starting with eyJ...
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# 3) Optional — EAS project UUID for Expo push tokens (native builds)
# Find in expo.dev → project settings, or after `eas init`
EXPO_PUBLIC_EAS_PROJECT_ID=
